# ──────────────────────────────────────────────────────────────────────────────
# Mobile Shop Inventory + POS + Mobile Service — environment configuration
#
# Copy to .env and fill in. Never commit .env (it is git-ignored).
#   Local (no Docker) ........ defaults below work with a local MySQL 8.
#   Docker development ....... docker compose up -d  (DB settings come from docker-compose.yml)
#   Docker production ........ see docs/deployment.md (APP_ENV=production, APP_DEBUG=false, secrets!)
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Mobile Shop POS"
# local | production
APP_ENV=local
# Generate with: php artisan key:generate  (production: keep it secret and never change it —
# it encrypts sessions and signed URLs)
APP_KEY=
# Must be false in production.
APP_DEBUG=true
# Keep UTC: transactions are stored in UTC; reports convert with REPORT_TIMEZONE.
APP_TIMEZONE=UTC
# Public URL (production: https://your-domain).
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
# Docker production logs to stderr (docker compose logs); local logs to storage/logs.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug locally; info or warning in production
LOG_LEVEL=debug

# ── Database (MySQL 8+; MariaDB is not supported) ─────────────────────────────
DB_CONNECTION=mysql
# Local: 127.0.0.1. Docker: set automatically to the "mysql" service.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mobile_shop_pos
# Production: a dedicated user, never root.
DB_USERNAME=root
DB_PASSWORD=
# Docker production only: root password of the MySQL container (used by backups/maintenance).
DB_ROOT_PASSWORD=

# ── Sessions, cache, queue (all stored in MySQL; no Redis needed) ─────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production behind HTTPS: set SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Uploaded files (organization logo) are stored on the private "local" disk.
FILESYSTEM_DISK=local
# No feature queues work today; the optional worker exists for future use.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (password reset links) ───────────────────────────────────────────────
# log writes mails to the log; configure smtp in production if password reset by e-mail is used.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Initial administrator (php artisan db:seed) ───────────────────────────────
# ADMIN_PASSWORD is required outside local/testing (locally an empty value means "password").
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Business settings ─────────────────────────────────────────────────────────
# Allow stock-out movements to take a balance below zero (normally false).
INVENTORY_ALLOW_NEGATIVE_STOCK=false

# Printed on receipts until set in Settings → Organization (which then takes precedence).
SHOP_NAME="${APP_NAME}"
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_RECEIPT_FOOTER="Thank you for shopping with us."

# Local time zone used to group reports by day/month (e.g. Asia/Dhaka).
REPORT_TIMEZONE=

# ── Docker development (docker-compose.yml) ───────────────────────────────────
# Host ports: app on http://localhost:8080, MySQL on 127.0.0.1:33306 (loopback only).
# APP_PORT=8080
# FORWARD_DB_PORT=33306
# Match your host user so bind-mounted files stay editable: UID=$(id -u) GID=$(id -g)
# UID=1000
# GID=1000
# DOCKER_DB_DATABASE=mobile_shop_pos
# DOCKER_DB_USERNAME=pos
# DOCKER_DB_PASSWORD=secret
# DOCKER_DB_ROOT_PASSWORD=root-secret

# ── Docker production (docker-compose.prod.yml) ───────────────────────────────
# Public HTTP port of the web container (put TLS in front, see docs/deployment.md).
# HTTP_PORT=80
# Image tag to run; set per release (e.g. 1.0.0) so rollbacks are a tag change.
# APP_VERSION=latest
# Run migrations when the app container starts (use for a deploy, then set back to false).
# RUN_MIGRATIONS=false
